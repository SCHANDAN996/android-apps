{
  "schemaVersion": 1,
  "id": "mahabharat",
  "naam": "महाभारत",
  "parichay": "अठारह पर्वों का सार — किस पर्व में कौन सी कथा है, और वह कहाँ तक पहुँचती है; और पाँच अंश पूरे पाठ और अर्थ के साथ: वन पर्व का यक्ष प्रश्न, उद्योग पर्व की विदुर नीति और सनत्सुजातीय, शांति पर्व का भीष्म स्तवराज, और अनुस्मृति। यह पूरा ग्रंथ नहीं है: महाभारत बहुत बड़ा है। गीता और विष्णु सहस्रनाम, जो इसी के हिस्से हैं, ग्रंथालय में पूरे पाठ के साथ अलग से हैं।",
  "khand": [
    {
      "shirshak": "पहले यह",
      "paath": [
        {
          "id": "mahabharat_parichay",
          "naam": "महाभारत — परिचय",
          "ekLine": "क्या है, कितना बड़ा है, और अठारह पर्व कैसे बँटे हैं",
          "shlok": 5
        }
      ]
    },
    {
      "shirshak": "युद्ध से पहले",
      "paath": [
        {
          "id": "mahabharat_p01",
          "naam": "आदि पर्व",
          "ekLine": "कुरुवंश, पांडवों का जन्म, द्रौपदी का विवाह, खांडव वन",
          "shlok": 6
        },
        {
          "id": "mahabharat_p02",
          "naam": "सभा पर्व",
          "ekLine": "पांडवों की सभा, राजसूय यज्ञ और जुआ",
          "shlok": 3
        },
        {
          "id": "mahabharat_p03",
          "naam": "वन पर्व",
          "ekLine": "वनवास — नल-दमयंती, सावित्री, रामायण की कथा, यक्ष के प्रश्न",
          "shlok": 8
        },
        {
          "id": "mahabharat_p04",
          "naam": "विराट पर्व",
          "ekLine": "वेश बदलकर विराट के नगर में",
          "shlok": 3
        },
        {
          "id": "mahabharat_p05",
          "naam": "उद्योग पर्व",
          "ekLine": "युद्ध की तैयारी और शांति की आख़िरी कोशिश",
          "shlok": 5
        }
      ]
    },
    {
      "shirshak": "अठारह दिन का युद्ध",
      "paath": [
        {
          "id": "mahabharat_p06",
          "naam": "भीष्म पर्व",
          "ekLine": "युद्ध के पहले दस दिन — और गीता",
          "shlok": 4
        },
        {
          "id": "mahabharat_p07",
          "naam": "द्रोण पर्व",
          "ekLine": "अभिमन्यु, जयद्रथ और द्रोण",
          "shlok": 4
        },
        {
          "id": "mahabharat_p08",
          "naam": "कर्ण पर्व",
          "ekLine": "शल्य सारथी, और कर्ण का वध",
          "shlok": 3
        },
        {
          "id": "mahabharat_p09",
          "naam": "शल्य पर्व",
          "ekLine": "युद्ध का अंत — शल्य का वध और गदायुद्ध",
          "shlok": 3
        },
        {
          "id": "mahabharat_p10",
          "naam": "सौप्तिक पर्व",
          "ekLine": "रात में सोते शिविर पर हमला",
          "shlok": 5
        }
      ]
    },
    {
      "shirshak": "युद्ध के बाद",
      "paath": [
        {
          "id": "mahabharat_p11",
          "naam": "स्त्री पर्व",
          "ekLine": "युद्ध के बाद का शोक",
          "shlok": 3
        },
        {
          "id": "mahabharat_p12",
          "naam": "शांति पर्व",
          "ekLine": "बाणों की शय्या पर भीष्म का उपदेश",
          "shlok": 3
        },
        {
          "id": "mahabharat_p13",
          "naam": "अनुशासन पर्व",
          "ekLine": "धर्म, दान और आचार — और भीष्म का स्वर्ग जाना",
          "shlok": 3
        },
        {
          "id": "mahabharat_p14",
          "naam": "आश्वमेधिक पर्व",
          "ekLine": "युधिष्ठिर का अश्वमेध यज्ञ",
          "shlok": 4
        },
        {
          "id": "mahabharat_p15",
          "naam": "आश्रमवासिक पर्व",
          "ekLine": "धृतराष्ट्र, गांधारी, कुंती और विदुर का वन जाना",
          "shlok": 4
        },
        {
          "id": "mahabharat_p16",
          "naam": "मौसल पर्व",
          "ekLine": "कृष्ण के कुल का अंत",
          "shlok": 4
        },
        {
          "id": "mahabharat_p17",
          "naam": "महाप्रस्थानिक पर्व",
          "ekLine": "पांडवों की आख़िरी यात्रा",
          "shlok": 3
        },
        {
          "id": "mahabharat_p18",
          "naam": "स्वर्गारोहण पर्व",
          "ekLine": "स्वर्ग, नरक का दृश्य, और मिलन",
          "shlok": 4
        }
      ]
    },
    {
      "shirshak": "महाभारत से — पूरा पाठ",
      "paath": [
        {
          "id": "mahabharat_yaksha",
          "naam": "यक्ष प्रश्न",
          "ekLine": "यक्ष के प्रश्न और युधिष्ठिर के उत्तर — पूरा पाठ, अर्थ सहित",
          "shlok": 48,
          "gintiNaam": "खंड"
        },
        {
          "id": "mahabharat_stavaraj",
          "naam": "भीष्म स्तवराज",
          "ekLine": "शरशय्या से भीष्म की श्रीकृष्ण-स्तुति — पूरा पाठ, अर्थ सहित",
          "shlok": 32,
          "gintiNaam": "खंड"
        },
        {
          "id": "mahabharat_anusmriti",
          "naam": "अनुस्मृति",
          "ekLine": "अन्त समय किसे याद करें — नारद का प्रश्न, भगवान का उत्तर; पूरा पाठ, अर्थ सहित",
          "shlok": 25,
          "gintiNaam": "खंड"
        }
      ]
    },
    {
      "shirshak": "विदुर नीति — उद्योग पर्व से",
      "paath": [
        {
          "id": "mahabharat_vn1",
          "naam": "विदुर नीति १ — पण्डित और मूढ़",
          "ekLine": "नींद न आने वाली रात; पण्डित कौन, मूढ़ कौन; एक से दस तक की गिनतियाँ — अध्याय ३३, पाठ और अर्थ",
          "shlok": 28,
          "gintiNaam": "खंड"
        },
        {
          "id": "mahabharat_vn2",
          "naam": "विदुर नीति २ — शरीर रथ है",
          "ekLine": "काम से पहले परिणाम, भौंरे की तरह लेना, इन्द्रियों के घोड़े — अध्याय ३४",
          "shlok": 17,
          "gintiNaam": "खंड"
        },
        {
          "id": "mahabharat_vn3",
          "naam": "विदुर नीति ३ — केशिनी का प्रश्न",
          "ekLine": "सरलता, और विरोचन-सुधन्वा की प्राणों की बाज़ी — अध्याय ३५",
          "shlok": 16,
          "gintiNaam": "खंड"
        },
        {
          "id": "mahabharat_vn4",
          "naam": "विदुर नीति ४ — हंस का उपदेश",
          "ekLine": "साध्य देवताओं और हंस का संवाद; ऊँचे कुल, मित्र और कुटुंब — अध्याय ३६",
          "shlok": 14,
          "gintiNaam": "खंड"
        },
        {
          "id": "mahabharat_vn5",
          "naam": "विदुर नीति ५ — वन और बाघ",
          "ekLine": "नरक ले जाने वाले सत्रह, आयु की छह तलवारें, पाँच बल — अध्याय ३७",
          "shlok": 22,
          "gintiNaam": "खंड"
        },
        {
          "id": "mahabharat_vn6",
          "naam": "विदुर नीति ६ — अतिथि, घर और राजा",
          "ekLine": "अतिथि-सत्कार, घर का प्रबंध, गुप्त मंत्रणा, लक्ष्मी की सात समिधाएँ — अध्याय ३८",
          "shlok": 16,
          "gintiNaam": "खंड"
        },
        {
          "id": "mahabharat_vn7",
          "naam": "विदुर नीति ७ — मित्रता, क्षमा और लक्ष्मी",
          "ekLine": "भाग्य की बात, एक पुत्र का त्याग, मित्र की परख, धर्म का सार — अध्याय ३९",
          "shlok": 18,
          "gintiNaam": "खंड"
        },
        {
          "id": "mahabharat_vn8",
          "naam": "विदुर नीति ८ — धर्म न छोड़े",
          "ekLine": "विद्यार्थी के दोष, आत्मा की नदी, चारों वर्णों का धर्म — अध्याय ४०",
          "shlok": 9,
          "gintiNaam": "खंड"
        }
      ]
    },
    {
      "shirshak": "सनत्सुजातीय — उद्योग पर्व से",
      "paath": [
        {
          "id": "mahabharat_ss1",
          "naam": "सनत्सुजातीय १ — मृत्यु और प्रमाद",
          "ekLine": "धृतराष्ट्र पूछते हैं: मृत्यु है या नहीं — अध्याय ४२, पाठ और अर्थ",
          "shlok": 13,
          "gintiNaam": "खंड"
        },
        {
          "id": "mahabharat_ss2",
          "naam": "सनत्सुजातीय २ — मौन, तप और सत्य",
          "ekLine": "तप का मैल, बारह व्रत, और वेद को जानने वाला कौन — अध्याय ४३",
          "shlok": 15,
          "gintiNaam": "खंड"
        },
        {
          "id": "mahabharat_ss3",
          "naam": "सनत्सुजातीय ३ — ब्रह्मचर्य",
          "ekLine": "ब्रह्मचर्य के चार पाद, और ब्रह्म का रूप — अध्याय ४४",
          "shlok": 8,
          "gintiNaam": "खंड"
        },
        {
          "id": "mahabharat_ss4",
          "naam": "सनत्सुजातीय ४ — दोष और व्रत",
          "ekLine": "बारह दोष, बारह महाव्रत, मित्रता के छह गुण — अध्याय ४५",
          "shlok": 6,
          "gintiNaam": "खंड"
        },
        {
          "id": "mahabharat_ss5",
          "naam": "सनत्सुजातीय ५ — योगी उसे देखते हैं",
          "ekLine": "टेक वाला अध्याय: «योगिनस्तं प्रपश्यन्ति भगवन्तं सनातनम्» — अध्याय ४६",
          "shlok": 8,
          "gintiNaam": "खंड"
        }
      ]
    }
  ]
}
