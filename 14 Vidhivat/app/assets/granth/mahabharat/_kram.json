{
  "schemaVersion": 1,
  "id": "mahabharat",
  "naam": "महाभारत",
  "parichay": "अठारह पर्वों का सार — किस पर्व में कौन सी कथा है, और वह कहाँ तक पहुँचती है; और वन पर्व का यक्ष प्रश्न पूरे पाठ और अर्थ के साथ। यह पूरा ग्रंथ नहीं है: महाभारत बहुत बड़ा है। गीता और विष्णु सहस्रनाम, जो इसी के हिस्से हैं, ग्रंथालय में पूरे पाठ के साथ अलग से हैं।",
  "khand": [
    {
      "shirshak": "पहले यह",
      "paath": [
        {
          "id": "mahabharat_parichay",
          "naam": "महाभारत — परिचय",
          "ekLine": "क्या है, कितना बड़ा है, और अठारह पर्व कैसे बँटे हैं",
          "shlok": 5
        }
      ]
    },
    {
      "shirshak": "युद्ध से पहले",
      "paath": [
        {
          "id": "mahabharat_p01",
          "naam": "आदि पर्व",
          "ekLine": "कुरुवंश, पांडवों का जन्म, द्रौपदी का विवाह, खांडव वन",
          "shlok": 6
        },
        {
          "id": "mahabharat_p02",
          "naam": "सभा पर्व",
          "ekLine": "पांडवों की सभा, राजसूय यज्ञ और जुआ",
          "shlok": 3
        },
        {
          "id": "mahabharat_p03",
          "naam": "वन पर्व",
          "ekLine": "वनवास — नल-दमयंती, सावित्री, रामायण की कथा, यक्ष के प्रश्न",
          "shlok": 8
        },
        {
          "id": "mahabharat_p04",
          "naam": "विराट पर्व",
          "ekLine": "वेश बदलकर विराट के नगर में",
          "shlok": 3
        },
        {
          "id": "mahabharat_p05",
          "naam": "उद्योग पर्व",
          "ekLine": "युद्ध की तैयारी और शांति की आख़िरी कोशिश",
          "shlok": 5
        }
      ]
    },
    {
      "shirshak": "अठारह दिन का युद्ध",
      "paath": [
        {
          "id": "mahabharat_p06",
          "naam": "भीष्म पर्व",
          "ekLine": "युद्ध के पहले दस दिन — और गीता",
          "shlok": 4
        },
        {
          "id": "mahabharat_p07",
          "naam": "द्रोण पर्व",
          "ekLine": "अभिमन्यु, जयद्रथ और द्रोण",
          "shlok": 4
        },
        {
          "id": "mahabharat_p08",
          "naam": "कर्ण पर्व",
          "ekLine": "शल्य सारथी, और कर्ण का वध",
          "shlok": 3
        },
        {
          "id": "mahabharat_p09",
          "naam": "शल्य पर्व",
          "ekLine": "युद्ध का अंत — शल्य का वध और गदायुद्ध",
          "shlok": 3
        },
        {
          "id": "mahabharat_p10",
          "naam": "सौप्तिक पर्व",
          "ekLine": "रात में सोते शिविर पर हमला",
          "shlok": 5
        }
      ]
    },
    {
      "shirshak": "युद्ध के बाद",
      "paath": [
        {
          "id": "mahabharat_p11",
          "naam": "स्त्री पर्व",
          "ekLine": "युद्ध के बाद का शोक",
          "shlok": 3
        },
        {
          "id": "mahabharat_p12",
          "naam": "शांति पर्व",
          "ekLine": "बाणों की शय्या पर भीष्म का उपदेश",
          "shlok": 3
        },
        {
          "id": "mahabharat_p13",
          "naam": "अनुशासन पर्व",
          "ekLine": "धर्म, दान और आचार — और भीष्म का स्वर्ग जाना",
          "shlok": 3
        },
        {
          "id": "mahabharat_p14",
          "naam": "आश्वमेधिक पर्व",
          "ekLine": "युधिष्ठिर का अश्वमेध यज्ञ",
          "shlok": 4
        },
        {
          "id": "mahabharat_p15",
          "naam": "आश्रमवासिक पर्व",
          "ekLine": "धृतराष्ट्र, गांधारी, कुंती और विदुर का वन जाना",
          "shlok": 4
        },
        {
          "id": "mahabharat_p16",
          "naam": "मौसल पर्व",
          "ekLine": "कृष्ण के कुल का अंत",
          "shlok": 4
        },
        {
          "id": "mahabharat_p17",
          "naam": "महाप्रस्थानिक पर्व",
          "ekLine": "पांडवों की आख़िरी यात्रा",
          "shlok": 3
        },
        {
          "id": "mahabharat_p18",
          "naam": "स्वर्गारोहण पर्व",
          "ekLine": "स्वर्ग, नरक का दृश्य, और मिलन",
          "shlok": 4
        }
      ]
    },
    {
      "shirshak": "महाभारत से — पूरा पाठ",
      "paath": [
        {
          "id": "mahabharat_yaksha",
          "naam": "यक्ष प्रश्न",
          "ekLine": "यक्ष के प्रश्न और युधिष्ठिर के उत्तर — पूरा पाठ, अर्थ सहित",
          "shlok": 48,
          "gintiNaam": "खंड"
        }
      ]
    }
  ]
}
