  "id": "hanuman_chalisa",
  "naam": "श्री हनुमान चालीसा",
  "upnaam": [
    "हनुमान चालीसा",
    "चालीसा"
  ],
  "prakar": "chalisa",
  "devta": "हनुमान जी",
  "rachnakar": "गोस्वामी तुलसीदास",
  "bhasha": "अवधी",
  "parichay": "गोस्वामी तुलसीदास की रची हुई चालीस चौपाइयों की स्तुति, जो हनुमान जी के गुण और पराक्रम कहती है। दो दोहों से शुरू होकर चालीस चौपाई और एक समापन दोहे पर पूरी होती है — कुल 43 पद।\n\nघर में सबसे ज़्यादा पढ़ी जाने वाली स्तुति यही है। इसे पूजा की तरह सामग्री या विधि नहीं चाहिए — बस बैठकर शुरू से आख़िर तक पढ़ना होता है।",
  "kabPadhein": "मंगलवार और शनिवार को ख़ास तौर पर; बाक़ी दिनों में भी कभी भी। सुबह स्नान के बाद या शाम को दीपक जलाकर पढ़ने का चलन है।",
  "kaisePadhein": "हाथ-मुँह धोकर साफ़ जगह पर आसन बिछाकर बैठें। हो सके तो हनुमान जी की तस्वीर के सामने दीपक जलाएँ। पूर्व या उत्तर की ओर मुँह रखें।\n\nपहले दोनों दोहे, फिर चालीस चौपाइयाँ क्रम से, अंत में समापन दोहा। जल्दबाज़ी न करें — शब्द साफ़ बोलें। कुछ लोग एक बार पढ़ते हैं, कुछ सात या ग्यारह बार; कोई पक्का नियम नहीं है।\n\n⚠️ यह पाठ है, पूजा नहीं — इसके लिए कोई सामग्री या संकल्प ज़रूरी नहीं।",
