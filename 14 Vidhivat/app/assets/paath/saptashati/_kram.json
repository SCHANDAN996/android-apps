{
  "schemaVersion": 1,
  "id": "saptashati",
  "naam": "दुर्गा सप्तशती",
  "parichay": "मार्कण्डेय पुराण का देवी माहात्म्य — तेरह अध्याय, तीन चरित्र। पाठ से पहले कवच, अर्गला, कीलक और रात्रि सूक्त; बाद में देवी सूक्त, तीन रहस्य और क्षमा प्रार्थना।",
  "khand": [
    {
      "shirshak": "पाठ से पहले",
      "paath": [
        {
          "id": "saptashati_kavach",
          "naam": "देवी कवच",
          "ekLine": "सप्तशती के पाठ से पहले पढ़ा जाने वाला पहला अंग",
          "shlok": 56
        },
        {
          "id": "saptashati_argala",
          "naam": "अर्गला स्तोत्र",
          "ekLine": "कवच के बाद दूसरा अंग",
          "shlok": 27
        },
        {
          "id": "saptashati_keelak",
          "naam": "कीलक स्तोत्र",
          "ekLine": "अर्गला के बाद तीसरा अंग, जिसके बाद तेरह अध्याय शुरू होते हैं",
          "shlok": 14
        },
        {
          "id": "saptashati_ratri_sukta",
          "naam": "रात्रि सूक्त",
          "ekLine": "ऋग्वेद का सूक्त — कीलक के बाद, पहले अध्याय से पहले",
          "shlok": 8
        }
      ]
    },
    {
      "shirshak": "प्रथम चरित्र — महाकाली",
      "paath": [
        {
          "id": "saptashati_01",
          "naam": "अध्याय १ — मधु-कैटभ वध",
          "ekLine": "मधुकैटभवधो नाम प्रथमोऽध्यायः",
          "shlok": 104
        }
      ]
    },
    {
      "shirshak": "मध्यम चरित्र — महालक्ष्मी",
      "paath": [
        {
          "id": "saptashati_02",
          "naam": "अध्याय २ — महिषासुर की सेना का वध",
          "ekLine": "महिषासुरसैन्यवधो नाम द्वितीयोऽध्यायः",
          "shlok": 69
        },
        {
          "id": "saptashati_03",
          "naam": "अध्याय ३ — महिषासुर वध",
          "ekLine": "महिषासुरवधो नाम तृतीयोऽध्यायः",
          "shlok": 44
        },
        {
          "id": "saptashati_04",
          "naam": "अध्याय ४ — इन्द्र आदि देवताओं की स्तुति",
          "ekLine": "शक्रादिस्तुतिर्नाम चतुर्थोऽध्यायः",
          "shlok": 42
        }
      ]
    },
    {
      "shirshak": "उत्तम चरित्र — महासरस्वती",
      "paath": [
        {
          "id": "saptashati_05",
          "naam": "अध्याय ५ — देवी और दूत का संवाद",
          "ekLine": "देव्या दूतसंवादो नाम पञ्चमोऽध्यायः",
          "shlok": 85
        },
        {
          "id": "saptashati_06",
          "naam": "अध्याय ६ — धूम्रलोचन वध",
          "ekLine": "शुम्भनिशुम्भसेनानीधूम्रलोचनवधो नाम षष्ठोऽध्यायः",
          "shlok": 24
        },
        {
          "id": "saptashati_07",
          "naam": "अध्याय ७ — चण्ड-मुण्ड वध",
          "ekLine": "चण्डमुण्डवधो नाम सप्तमोऽध्यायः",
          "shlok": 27
        },
        {
          "id": "saptashati_08",
          "naam": "अध्याय ८ — रक्तबीज वध",
          "ekLine": "रक्तबीजवधो नामाष्टमोऽध्यायः",
          "shlok": 63
        },
        {
          "id": "saptashati_09",
          "naam": "अध्याय ९ — निशुम्भ वध",
          "ekLine": "निशुम्भवधो नाम नवमोऽध्यायः",
          "shlok": 41
        },
        {
          "id": "saptashati_10",
          "naam": "अध्याय १० — शुम्भ वध",
          "ekLine": "शुम्भवधो नाम दशमोऽध्यायः",
          "shlok": 32
        },
        {
          "id": "saptashati_11",
          "naam": "अध्याय ११ — नारायणी स्तुति",
          "ekLine": "नारायणीस्तुतिर्नामैकादशोऽध्यायः",
          "shlok": 55
        },
        {
          "id": "saptashati_12",
          "naam": "अध्याय १२ — देवी के वचन",
          "ekLine": "भगवती वाक्यं द्वादशोऽध्यायः",
          "shlok": 41
        },
        {
          "id": "saptashati_13",
          "naam": "अध्याय १३ — सुरथ और वैश्य को वरदान",
          "ekLine": "सुरथवैश्ययोर्वरप्रदानं नाम त्रयोदशोऽध्यायः",
          "shlok": 29
        }
      ]
    },
    {
      "shirshak": "पाठ के बाद",
      "paath": [
        {
          "id": "saptashati_devi_sukta",
          "naam": "देवी सूक्त",
          "ekLine": "ऋग्वेद का सूक्त — तेरह अध्यायों के बाद",
          "shlok": 8
        },
        {
          "id": "saptashati_pradhanik",
          "naam": "प्राधानिक रहस्य",
          "ekLine": "तीन रहस्यों में पहला — महालक्ष्मी से तीनों देवियों और देवताओं का प्रकट होना",
          "shlok": 29
        },
        {
          "id": "saptashati_vaikritik",
          "naam": "वैकृतिक रहस्य",
          "ekLine": "तीन रहस्यों में दूसरा — तीनों देवियों के रूप, आयुध और पूजा का क्रम",
          "shlok": 39
        },
        {
          "id": "saptashati_murti",
          "naam": "मूर्ति रहस्य",
          "ekLine": "तीन रहस्यों में तीसरा — नन्दा, रक्तदन्तिका, शाकम्भरी, भीमा और भ्रामरी के रूप",
          "shlok": 25
        },
        {
          "id": "saptashati_kshama",
          "naam": "क्षमा प्रार्थना",
          "ekLine": "पाठ के अंत में — भूल-चूक के लिए देवी से क्षमा",
          "shlok": 8
        }
      ]
    }
  ]
}
